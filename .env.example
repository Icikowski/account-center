## Instance configuration

# Visible instance name, used as a prefix and in titles
# Optional, not displayed by default
#
# AC_INSTANCE_NAME="Example Inc."

# Base URL (used for OIDC callback, etc.)
# Optional, default to origin request URL
#
# AC_INSTANCE_BASE_URL="http://account.example.com"

## Server configuration

# Address for binding HTTP server
# Optional, defaults to "" (listen on 0.0.0.0)
#
# AC_SERVER_ADDRESS="10.0.0.1"

# Port for binding HTTP server
# Optional, defaults to 8080
#
# AC_SERVER_PORT=8080

# Trusted reverse proxies allowed to supply X-Forwarded-Host / X-Forwarded-Proto
# Optional, defaults to empty (forwarded headers are ignored)
#
# AC_SERVER_TRUSTED_PROXIES="127.0.0.1/32,10.0.0.0/8"

## Services catalog configuration

# Path to YAML file with service catalog
# Optional, defaults to "./catalog.yaml"
#
# AC_CATALOG_PATH="./local/catalog.yaml"

# Service catalog live reload debounce
# Optional, defaults to 500ms
#
# AC_CATALOG_RELOAD_DEBOUNCE=500ms

## Knowledge base articles configuration

# Enable/Disable knowledge base articles module
# Optional, defaults to false
#
# AC_KB_ENABLED=true

# Path to directory with knowledge base articles (Markdown files)
# Optional, defaults to "./kb"
#
# AC_KB_PATH="./local/kb"

# Knowledge base articles live reload debounce
# Optional, defaults to 500ms
#
# AC_KB_RELOAD_DEBOUNCE=500ms

## Auth session storage configuration

# Persisted auth session TTL
# Optional, defaults to 24h
#
# AC_AUTH_SESSION_TTL=24h

# Temporary OIDC login-state TTL (state, nonce, PKCE verifier)
# Optional, defaults to 10m
#
# AC_AUTH_LOGIN_STATE_TTL=10m

# Auth session cookie name
# Optional, defaults to "account-center-session"
#
# AC_AUTH_SESSION_COOKIE_NAME=account-center-session

## OpenID Connect authentication configuration

# OIDC provider URL
# Required to start the application
#
# AC_OIDC_PROVIDER_URL="https://sso.example.com"

# OIDC client ID
# Required to start the application
#
# AC_OIDC_CLIENT_ID="some-client-id"

# OIDC client secret
# Required to start the application
#
# AC_OIDC_CLIENT_SECRET="some-client-secret"

# Refresh access tokens automatically when they are close to expiring
# Optional, defaults to 1m
#
# AC_OIDC_REFRESH_BEFORE=1m

## Redis configuration

# Enable/Disable Redis-based auth storage
# Optional, defaults to false
#
# AC_REDIS_ENABLED=true

# Redis address for auth storage
# Optional unless Redis-based auth storage is used
#
# AC_REDIS_ADDRESS="127.0.0.1:6379"

# Redis username
# Optional
#
# AC_REDIS_USERNAME=""

# Redis password
# Optional
#
# AC_REDIS_PASSWORD=""

# Redis database number
# Optional, defaults to 0
#
# AC_REDIS_DATABASE=0

# Redis key prefix for auth storage
# Optional, defaults to "account-center"
#
# AC_REDIS_KEY_PREFIX="account-center"

## Logging configuration

# Logging level
# Optional, defaults to "info"
#
# AC_LOG_LEVEL=info

# Enable pretty logging (resource intensive, not recommended)
# Optional, defaults to false
#
# AC_LOG_PRETTY=false
