package layouts

import (
	"git.sr.ht/~icikowski/account-center/internal/buildinfo"
	"git.sr.ht/~icikowski/account-center/internal/i18n"
	"git.sr.ht/~icikowski/account-center/internal/web/components/avatar"
	"git.sr.ht/~icikowski/account-center/internal/web/components/badge"
	"git.sr.ht/~icikowski/account-center/internal/web/components/button"
	"git.sr.ht/~icikowski/account-center/internal/web/components/buttongroup"
	"git.sr.ht/~icikowski/account-center/internal/web/components/dialog"
	"git.sr.ht/~icikowski/account-center/internal/web/components/icon"
	"git.sr.ht/~icikowski/account-center/internal/web/components/table"
)

templ aboutDialog(bd BaseData) {
	@dialog.Header() {
		<div class="flex items-center gap-4">
			@avatar.Avatar(avatar.Props{Class: "overflow-hidden rounded-lg after:rounded-lg"}) {
				@avatar.Image(avatar.ImageProps{
					Src:   "/assets/img/logo.png",
					Alt:   i18n.T(ctx, i18n.KeyGeneralAccountCenter),
					Class: "rounded-lg",
				})
			}
			<div class="max-w-full">
				@dialog.Title(dialog.TitleProps{Class: "text-left"}) {
					{ i18n.T(ctx, i18n.KeyGeneralAccountCenter) }
				}
				if bd.InstanceName != "" {
					@dialog.Description(dialog.DescriptionProps{Class: "text-left"}) {
						{ bd.InstanceName }
					}
				}
			</div>
		</div>
	}
	{{
		var (
			bi  = buildinfo.Get()
			bt  = "unknown"
			bts = "unknown"
		)
		if !bi.BuildTime.IsZero() {
			bt = bi.BuildTime.Local().Format("2006-01-02 15:04:05 MST")
			bts = bi.BuildTime.Format("2006-01-02 15:04:05 MST")
		}
	}}
	<div class="space-y-4">
		<div class="space-y-2 text-sm">
			@table.Table() {
				@table.Body() {
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, i18n.KeyAboutVersion) }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{Class: "font-mono"}) {
								{ bi.Version }
							}
						}
					}
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, i18n.KeyAboutBuildTime) }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{
								Class: "font-mono",
								Attributes: templ.Attributes{
									"title": bts,
								},
							}) {
								{ bt }
							}
						}
					}
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, i18n.KeyAboutGitReference) }
						}
						@table.Cell() {
							<a
								href={ "https://git.sr.ht/~icikowski/account-center/refs/" + bi.GitReference }
								target="_blank"
								class="block max-w-full text-inherit no-underline hover:underline"
							>
								@badge.Badge(badge.Props{
									Class: "w-full justify-start whitespace-normal break-all font-mono sm:w-fit sm:justify-center",
								}) {
									<code class="whitespace-normal break-all">{ bi.GitReference }</code>
								}
							</a>
						}
					}
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, i18n.KeyAboutGoVersion) }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{Class: "font-mono"}) {
								{ bi.GoVersion }
							}
						}
					}
					@table.Row() {
						@table.Head() {
							{ i18n.T(ctx, i18n.KeyAboutArchitecture) }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{Class: "font-mono"}) {
								{ bi.Architecture }
							}
						}
					}
				}
			}
		</div>
		<div class="flex flex-wrap items-center justify-center gap-2">
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{
					Size:       button.SizeIcon,
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"title": i18n.T(ctx, i18n.KeyAboutLinkProject)},
					Href:       "https://sr.ht/~icikowski/account-center",
					Target:     "_blank",
				}) {
					@icon.FolderGit(icon.Props{Class: "size-4"})
				}
			}
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{
					Size:       button.SizeIcon,
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"title": i18n.T(ctx, i18n.KeyAboutLinkRepository)},
					Href:       "https://git.sr.ht/~icikowski/account-center",
					Target:     "_blank",
				}) {
					@icon.GitBranch(icon.Props{Class: "size-4"})
				}
				@button.Button(button.Props{
					Size:       button.SizeIcon,
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"title": i18n.T(ctx, i18n.KeyAboutLinkMirror)},
					Href:       "https://github.com/Icikowski/account-center",
					Target:     "_blank",
				}) {
					@icon.GitFork(icon.Props{Class: "size-4"})
				}
			}
			@buttongroup.ButtonGroup() {
				@button.Button(button.Props{
					Size:       button.SizeIcon,
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"title": i18n.T(ctx, i18n.KeyAboutLinkMailingLists)},
					Href:       "https://sr.ht/~icikowski/account-center/lists",
					Target:     "_blank",
				}) {
					@icon.Mails(icon.Props{Class: "size-4"})
				}
				@button.Button(button.Props{
					Size:       button.SizeIcon,
					Variant:    button.VariantOutline,
					Attributes: templ.Attributes{"title": i18n.T(ctx, i18n.KeyAboutLinkIssueTracker)},
					Href:       "https://todo.sr.ht/~icikowski/account-center",
					Target:     "_blank",
				}) {
					@icon.Bug(icon.Props{Class: "size-4"})
				}
			}
		</div>
	</div>
}
