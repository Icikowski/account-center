package templates

import (
	"git.sr.ht/~icikowski/account-center/internal/consts"
	"git.sr.ht/~icikowski/account-center/internal/i18n"
	"git.sr.ht/~icikowski/account-center/internal/web/components/button"
	"git.sr.ht/~icikowski/account-center/internal/web/components/card"
	"git.sr.ht/~icikowski/account-center/internal/web/components/field"
	"git.sr.ht/~icikowski/account-center/internal/web/layouts"
)

templ Login() {
	@layouts.Page("", nil) {
		<div class="flex flex-1 items-center justify-center">
			<div class="w-full max-w-4xl">
				@card.Card(card.Props{Class: "overflow-hidden p-0"}) {
					@card.Content(card.ContentProps{Class: "grid p-0 md:grid-cols-2"}) {
						<div class="p-6 md:p-8">
							@field.Group() {
								<div class="flex flex-col items-center gap-2 text-center">
									<h1 class="text-2xl font-bold">
										{ i18n.T(ctx, i18n.KeyGeneralAccountCenter) }
									</h1>
									<p class="text-balance text-muted-foreground">
										{ i18n.T(ctx, i18n.KeyWelcomeMessage) }
									</p>
								</div>
								@field.Field() {
									@button.Button(button.Props{
										Class: "w-full",
										Size:  button.SizeLg,
										Href:  consts.RouteLogin,
									}) {
										{ i18n.T(ctx, i18n.KeyAuthLogin) }
									}
								}
							}
						</div>
						<div class="relative hidden overflow-hidden bg-gradient-to-br from-[#3b8f9b] via-[#6db99a] to-[#88bc96] md:flex md:items-center md:justify-center">
							<div class="absolute size-56 rounded-full bg-white/10 blur-3xl"></div>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								class="relative size-40 text-white/95 drop-shadow-lg"
								fill="currentColor"
								aria-hidden="true"
							>
								<path d="M12 1.2A4.8 4.8 0 1 0 16.8 6 4.805 4.805 0 0 0 12 1.2zm0 8.6A3.8 3.8 0 1 1 15.8 6 3.804 3.804 0 0 1 12 9.8zM9 22H4l.01-4.5A5.498 5.498 0 0 1 9.5 12h4.312a5.968 5.968 0 0 0-.462 1H9.5A4.505 4.505 0 0 0 5 17.5V21h4zm10-10.9a3.9 3.9 0 0 0-3.9 3.9 3.86 3.86 0 0 0 .225 1.255L11 20.727V23h2.993l.023-.01L15 22v-1h1.005L17 20v-1h1.004l.186-.187A3.9 3.9 0 1 0 19 11.1zm0 6.9a2.973 2.973 0 0 1-1.223-.267l-.272.267H16v2h-2v1.674l-.408.326H12v-.906l4.419-4.591A2.965 2.965 0 0 1 16 15a3 3 0 1 1 3 3zm.5-5a1.5 1.5 0 1 0 1.5 1.5 1.5 1.5 0 0 0-1.5-1.5zm0 2a.5.5 0 1 1 .5-.5.501.501 0 0 1-.5.5z"></path>
							</svg>
						</div>
					}
				}
			</div>
		</div>
	}
}
