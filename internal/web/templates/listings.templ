package templates

import (
	"git.sr.ht/~icikowski/account-center/internal/i18n"
	"git.sr.ht/~icikowski/account-center/internal/model"
	"git.sr.ht/~icikowski/account-center/internal/web/components/avatar"
	"git.sr.ht/~icikowski/account-center/internal/web/components/badge"
	"git.sr.ht/~icikowski/account-center/internal/web/components/button"
	"git.sr.ht/~icikowski/account-center/internal/web/components/card"
	"git.sr.ht/~icikowski/account-center/internal/web/components/empty"
	"git.sr.ht/~icikowski/account-center/internal/web/components/icon"
	"git.sr.ht/~icikowski/account-center/internal/web/layouts"
)

type tileRenderer[T any] func(item T) templ.Component

templ tileGrid[T any](items []T, renderer tileRenderer[T]) {
	<div class="grid grid-flow-row gap-4 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
		for _, item := range items {
			@renderer(item)
		}
	</div>
}

templ catalogServiceTile(svc model.EffectiveService) {
	<div class="h-auto max-w-full">
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ svc.Name }
				}
				@card.Description() {
					@badge.Badge() {
						{ i18n.T(ctx, i18n.UserRoleKey(svc.EffectiveRole)) }
					}
				}
				if svc.Icon != nil {
					@card.Action() {
						@avatar.Avatar(avatar.Props{Class: "overflow-hidden rounded-lg after:hidden"}) {
							@avatar.Image(avatar.ImageProps{
								Src:   svc.Icon.String(),
								Alt:   svc.Name,
								Class: "rounded-lg",
							})
							@avatar.Fallback(avatar.FallbackProps{Class: "rounded-lg"}) {
								@icon.Box(icon.Props{Class: "size-4"})
							}
						}
					}
				}
			}
			@card.Content() {
				@button.Button(button.Props{
					Href:   svc.URL.String(),
					Target: "_blank",
					Class:  "w-full",
				}) {
					{ i18n.T(ctx, i18n.KeyCatalogGoToService) }
				}
			}
		}
	</div>
}

templ knowledgeBaseArticleTile(article model.KnowledgeBaseListingArticle) {
	{{
		cardClass := ""
		if article.FeaturedImageURL != "" {
			cardClass = "pt-0"
		}
	}}
	<div class="h-auto max-w-full">
		@card.Card(card.Props{Class: cardClass}) {
			if article.FeaturedImageURL != "" {
				<img
					src={ article.FeaturedImageURL }
					alt={ article.Article.Title }
					loading="lazy"
					class="aspect-video w-full object-cover"
				/>
			}
			@card.Header() {
				@card.Title() {
					{ article.Article.Title }
				}
			}
			@card.Content() {
				{ article.Article.Description }
			}
			@card.Footer() {
				@button.Button(button.Props{
					Href:  article.URL,
					Class: "w-full",
				}) {
					{ i18n.T(ctx, i18n.KeyKnowledgeBaseGoToArticle) }
				}
			}
		}
	</div>
}

templ Catalog(services []model.EffectiveService) {
	@layouts.Page(i18n.T(ctx, i18n.KeySectionCatalog), layouts.NavigationCatalog) {
		if len(services) == 0 {
			@empty.Empty(empty.Props{Class: "border"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.LayoutDashboard()
					}
					@empty.Title() {
						{ i18n.T(ctx, i18n.KeyCatalogNoServices) }
					}
					@empty.Description() {
						{ i18n.T(ctx, i18n.KeyCatalogNoServicesMessage) }
					}
				}
			}
		} else {
			@tileGrid(services, catalogServiceTile)
		}
	}
}

templ KnowledgeBase(articles []model.KnowledgeBaseListingArticle) {
	@layouts.Page(i18n.T(ctx, i18n.KeySectionKnowledgeBase), layouts.NavigationKnowledgeBase) {
		if len(articles) == 0 {
			@empty.Empty(empty.Props{Class: "border"}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.NotebookTabs()
					}
					@empty.Title() {
						{ i18n.T(ctx, i18n.KeyKnowledgeBaseNoArticles) }
					}
					@empty.Description() {
						{ i18n.T(ctx, i18n.KeyKnowledgeBaseNoArticlesMessage) }
					}
				}
			}
		} else {
			@tileGrid(articles, knowledgeBaseArticleTile)
		}
	}
}
